# Rendered by the nginx image entrypoint (envsubst of $PUBLIC_HOST and $EDGE_*) into /etc/nginx/conf.d/default.conf,
# replacing the image's packaged default server.

# Docker's embedded DNS: re-resolve service names so scaled/restarted API replicas are picked up.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream api_backend {
    zone api_backend 64k;
    least_conn;
    server api:8080 resolve max_fails=3 fail_timeout=10s;
    keepalive 32;
}

upstream web_frontend {
    zone web_frontend 64k;
    server web:8080 resolve;
    keepalive 8;
}

# Coarse edge limits (fine-grained, per-user limits are enforced by the API through Redis).
limit_req_zone  $binary_remote_addr zone=api_per_ip:10m  rate=${EDGE_API_RATE_PER_SECOND}r/s;
limit_req_zone  $binary_remote_addr zone=auth_per_ip:10m rate=${EDGE_AUTH_RATE_PER_SECOND}r/s;
limit_conn_zone $binary_remote_addr zone=conn_per_ip:10m;
limit_req_status  429;
limit_conn_status 429;

server {
    listen 8080 default_server;
    server_name _;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8443 ssl default_server;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 1m;
    limit_conn conn_per_ip 100;

    location /api/v1/auth/ {
        limit_req zone=auth_per_ip burst=10 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location /api/ {
        limit_req zone=api_per_ip burst=60 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location /health/ {
        access_log off;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # API documentation (only answers when OPENAPI_ENABLED=true); Swagger UI needs inline scripts.
    location ~ ^/(swagger|openapi)(/|$) {
        include /etc/nginx/snippets/security-headers-docs.conf;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location / {
        proxy_pass http://web_frontend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

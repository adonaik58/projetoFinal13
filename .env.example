# =============================================================================
# Xyami.Park — environment configuration (copy to .env and fill in every secret)
# Generate secrets with:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-32
# NEVER commit the real .env file.
# =============================================================================

# --- Images / deployment ------------------------------------------------------
IMAGE_REGISTRY=xyami-park
IMAGE_TAG=local
ASPNETCORE_ENVIRONMENT=Production
API_REPLICAS=2

# --- Public endpoint ----------------------------------------------------------
PUBLIC_HOST=localhost
HTTP_PORT=80
HTTPS_PORT=443
# Directory with fullchain.pem / privkey.pem (see infra/nginx/certs/README.md)
TLS_CERTS_DIR=./infra/nginx/certs

# --- MySQL --------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=parking
# Schema owner: used only by the one-shot migrator
MYSQL_USER=parking
MYSQL_PASSWORD=
# Runtime user for the API (SELECT/INSERT/UPDATE/DELETE only)
MYSQL_APP_USER=parking_app
MYSQL_APP_PASSWORD=
# Read-only user for backups
MYSQL_BACKUP_USER=parking_backup
MYSQL_BACKUP_PASSWORD=
# Connection pool per API replica
MYSQL_MAX_POOL_SIZE=50

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=

# --- Security -----------------------------------------------------------------
# HMAC-SHA256 key for access tokens (>= 32 characters)
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- First start (only used while the users table is empty) ------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_RATE_PER_MINUTE=10
BOOTSTRAP_FREE_HOURS=0
BOOTSTRAP_MAX_SPACES=250

# --- Application --------------------------------------------------------------
BUSINESS_TIMEZONE=Africa/Luanda
# Per-user API limit and per-IP login limit (requests/minute, shared by all replicas via Redis)
RATE_LIMIT_DEFAULT_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=10
# Coarse per-IP limits at the Nginx edge (requests/second)
EDGE_API_RATE_PER_SECOND=30
EDGE_AUTH_RATE_PER_SECOND=5
# Expose /swagger and /openapi/v1.json (keep false in production)
OPENAPI_ENABLED=false

# --- Backups ------------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# --- Observability (profile "observability") ----------------------------------
# Set to http://otel-collector:4317 when running with --profile observability
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
